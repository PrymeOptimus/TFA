# Copy to .env for local development. Placeholders only — never commit real secrets.
# development | test | production
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Runtime role (no BYPASSRLS, owns nothing). Used by the web app and worker.
DATABASE_URL=postgres://crm_app:crm_app_local_only@localhost:5432/crm_dev
# Migration/seed role (owns schema). Not used at runtime.
DATABASE_OWNER_URL=postgres://crm_owner:crm_owner_local_only@localhost:5432/crm_dev
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Messaging adapter. "local" = local simulation (rejected when APP_ENV=production).
MESSAGING_PROVIDER=local
# Salt used to hash submitter IPs for rate limiting (never store raw IPs).
IP_HASH_SALT=replace-with-random-string
# Seeded demo account password (local synthetic accounts only).
SEED_PASSWORD=Demo-Password-2026!
# Worker tuning
WORKER_POLL_MS=500
WORKER_LEASE_SECONDS=30
LOG_LEVEL=info
