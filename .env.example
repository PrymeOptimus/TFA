# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hearth?schema=public"

# ── Auth.js (NextAuth) ──────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Google OAuth (login + Calendar API) ─────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Token encryption (AES-256-GCM key for stored refresh/access tokens) ────
# generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# ── Weather (OpenWeatherMap or WeatherAPI) ──────────────────────────────────
WEATHER_PROVIDER="openweathermap"
OPENWEATHER_API_KEY=""

# ── Storage (Supabase Storage or S3-compatible) ─────────────────────────────
STORAGE_DRIVER="local" # "local" | "supabase" | "s3"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hearth-photos"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Microsoft OAuth (Phase 3 — Outlook Calendar) ────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-string"
